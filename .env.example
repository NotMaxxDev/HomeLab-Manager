APP_NAME=HomelabManager
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:4000
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

# Port auf dem die App (Nginx) erreichbar ist
APP_PORT=4000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Datenbank (PostgreSQL Standard, MySQL alternativ)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=homelab
DB_USERNAME=homelab
DB_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# Redis (Cache / Queue / Broadcasting)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ---------------------------------------------------------------------------
# Docker Engine API
# ---------------------------------------------------------------------------
# Pfad zum Docker-Socket innerhalb des app-Containers.
# Empfohlen: Docker-Socket-Proxy verwenden und hier die TCP-URL angeben.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Falls ein Socket-Proxy (z. B. tecnativa/docker-socket-proxy) genutzt wird:
# DOCKER_SOCKET_PATH=tcp://socket-proxy:2375
# Host-Verzeichnis für /proc-Auslesung (Host-Metriken), gemountet im app-Container
HOST_PROC_PATH=/host/proc

# ---------------------------------------------------------------------------
# Reverb (WebSockets)
# ---------------------------------------------------------------------------
REVERB_APP_ID=homelab-manager
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me-too
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
